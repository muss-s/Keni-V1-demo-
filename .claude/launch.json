{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "keni",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const fs=require('fs'),p=require('path'),T={'.html':'text/html','.jpg':'image/jpeg','.png':'image/png','.webp':'image/webp','.svg':'image/svg+xml','.gif':'image/gif'},root=process.cwd();require('http').createServer((q,s)=>{const u=decodeURIComponent(q.url.split('?')[0]);if(u==='/'||u==='/index.html'||u==='/keni.html'){s.setHeader('content-type','text/html');return s.end(fs.readFileSync(p.join(root,'keni.html')))}const f=p.join(root,u);if(!u.startsWith('/images/')||!f.startsWith(p.join(root,'images'))||!fs.existsSync(f)||fs.statSync(f).isDirectory()){s.statusCode=404;return s.end('not found')}s.setHeader('content-type',T[p.extname(f)]||'application/octet-stream');s.end(fs.readFileSync(f))}).listen(process.env.PORT||5173)"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "keni-real",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const fs=require('fs'),p=require('path'),T={'.html':'text/html','.jpg':'image/jpeg','.png':'image/png','.webp':'image/webp','.svg':'image/svg+xml','.gif':'image/gif','.json':'application/manifest+json','.js':'text/javascript'},root=p.join(process.cwd(),'keni-real');require('http').createServer((q,s)=>{const u=decodeURIComponent(q.url.split('?')[0]);if(u==='/'||u==='/index.html'){s.setHeader('content-type','text/html');return s.end(fs.readFileSync(p.join(root,'index.html')))}if(u==='/get'||u==='/get.html'){s.setHeader('content-type','text/html');return s.end(fs.readFileSync(p.join(root,'get.html')))}if(u==='/admin'||u==='/admin.html'){s.setHeader('content-type','text/html');return s.end(fs.readFileSync(p.join(root,'admin.html')))}const f=p.join(root,u);const ok=(u.startsWith('/images/')||u.startsWith('/icons/')||u==='/manifest.json'||u==='/sw.js')&&f.startsWith(root);if(!ok||!fs.existsSync(f)||fs.statSync(f).isDirectory()){s.statusCode=404;return s.end('not found')}s.setHeader('content-type',T[p.extname(f)]||'application/octet-stream');s.end(fs.readFileSync(f))}).listen(process.env.PORT||5176)"
